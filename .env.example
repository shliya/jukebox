# 複製成 .env 後填入實際值（.env 不進版控）

PORT=3002
# development / production（production 會改用 DATABASE_URL 並開 SSL）
NODE_ENV=development

# ---- 資料庫 ----
# 開發 / 測試用
TEST_DB_URL=postgres://postgres:postgres@localhost:5432/jukebox_dev
# 正式站
DATABASE_URL=

# ---- 安全 ----
# 票券登入 cookie 的簽章金鑰（至少 32 字元，必填）
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 管理 API（排行榜總覽、新增歌曲）用的 token，請求帶 header: x-admin-token
# 未設定時所有管理 API 一律拒絕
ADMIN_TOKEN=
# 允許帶 cookie 的跨來源（逗號分隔）；未設定時不開 credentials
ALLOWED_ORIGINS=
