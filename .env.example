# 複製成 .env 後填入實際值（.env 不進版控）

PORT=3002
# development / production（production 會改用 DATABASE_URL 並開 SSL）
NODE_ENV=development

# ---- 資料庫 ----
# 開發 / 測試用（對應 docker-compose.yml，先 docker compose up -d）
TEST_DB_URL=postgres://postgres:postgres@localhost:5433/jukebox_dev
# 正式站（NODE_ENV=production 時使用）
# Supabase → Connect → Connection String → Method 選「Session pooler」（port 5432）
# 例：postgresql://postgres.<project-ref>:<密碼>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 不要用 Direct connection（只有 IPv6，Render 連不到）；密碼有特殊符號要先 encodeURIComponent
DATABASE_URL=

# ---- 安全 ----
# 票券登入 cookie 的簽章金鑰（至少 32 字元，必填）
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 允許帶 cookie 的跨來源（逗號分隔）；未設定時不開 credentials
ALLOWED_ORIGINS=
